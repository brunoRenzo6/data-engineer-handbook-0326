-- game_details, has (game_id, player_id) grain, but it has duplicates

-- note that we can not simply have all grouping sets agg on a same grain.
-- metrics like team sum_wins, can not be agg at the player level.
-- while player sum_wins naturally can.
-- therefore we setup an agg for metrics on the player grain, and metrics on the game grain.


drop table if exists game_details_agg; 
create temporary table game_details_agg as
with game_details_rn as (
	select *, 
	row_number() over(partition by game_id, player_id) as rn
	from game_details
),
game_details_deduped as(
	select * from game_details_rn
	where rn=1
),
game_details_w_na as (
	select
	a.game_id,
	coalesce(cast(a.team_id as varchar), 'N/A') as team_id,
	coalesce(cast(a.player_id as varchar), 'N/A') as player_id,
	coalesce(cast(b.season as varchar), 'N/A') as season,
	a.pts,
	cast(b.home_team_id as varchar) as home_team_id,
	b.home_team_wins
	from game_details_deduped a 
	left join games b
		on a.game_id = b.game_id
),
player_additive as (
	select
	coalesce(team_id, 'overall') as team_id,
	coalesce(player_id, 'overall') as player_id,
	coalesce(season, 'overall') as season,
	sum(pts) as sum_pts,
	sum(
		case
			when (team_id = home_team_id) and home_team_wins = 1
				then 1
			when (team_id != home_team_id) and home_team_wins = 0
				then 1
			else 0
		end
	) as sum_wins
	from game_details_w_na
	group by grouping sets (
		(team_id, player_id),
		(season, player_id)
	)
),
game_grain as (
	select
	team_id,
	season,
	game_id,
	sum(pts) as pts,
	min(
		case
			when (team_id = home_team_id) and home_team_wins = 1
				then 1
			when (team_id != home_team_id) and home_team_wins = 0
				then 1
			else 0
		end
	) as win
	from game_details_w_na
	group by team_id, season, game_id
),
game_additive as (
	select
	team_id,
	'overall' as player_id,
	'overall' as season,
	sum(pts) as sum_pts,
	sum(win) as sum_wins
	from game_grain
	group by team_id
)
select * from player_additive
union all 
select * from game_additive



select * from team_grain
order by team_id, season, game_id



-- ## Who scored the most points playing for one team?

with player_names as (
	select
	distinct 
	cast(player_id as varchar) as player_id, 
	player_name
	from game_details
)
select 
b.player_name,
c.nickname,
a.sum_pts
from game_details_agg a
left join player_names b
	on a.player_id = b.player_id
left join teams c
	on a.team_id = cast(c.team_id as varchar)
where 
a.season = 'overall'
and a.player_id != 'overall'
and a.team_id != 'overall'
and a.sum_pts is not null
order by a.sum_pts desc
;

