-- ## How many games in a row did LeBron James score over 10 points a game?

-- games, has (game_id) grain

with game_details_rn as (
	select *, 
	row_number() over(partition by game_id, player_id) as rn
	from game_details
),
game_details_deduped as(
	select * from game_details_rn
	where rn=1
),
t1 as (
	select
	a.game_id,
	a.team_id,
	a.player_name,
	a.pts,
	b.game_date_est,
	case 
		when coalesce(pts, 0) <= 10
			then 1
		else 0
	end as reset_streak
	from game_details_deduped a 
	left join games b
		on a.game_id = b.game_id
	where a.player_name = 'LeBron James'
),
t2 as (
	select
	*,
	sum(reset_streak) over(partition by player_name order by game_date_est) as streak_id
	from t1
)
select
player_name, 
streak_id,
min(game_date_est) as streak_init_date,
count(*) as streak,
array_agg(row(game_date_est, pts)) as streak_details
from t2
where reset_streak = 0
group by player_name, streak_id
order by streak desc

-- player_name; 	streak_init_date; 	streak
