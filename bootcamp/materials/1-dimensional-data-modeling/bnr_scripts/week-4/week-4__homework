-- # A query that does state change tracking for players

drop table players_state;
create table players_state (
	player_name varchar,
	player_state varchar,
	last_active_season date,
	current_season date
);


insert into players_state
with prev as (
	select
	*
	from players_state
	where current_season = '1997-01-01'
),
curr as (
	select
	player_name,
	to_date(cast(season as varchar), 'YYYY') as season
	from player_seasons
	where season = 1998
)
select
	coalesce(p.player_name, c.player_name) as player_name,
	case 
		when p.player_name is null
			then 'New'
		when (c.player_name is null) and 
		(p.current_season = p.last_active_season)
			then 'Retired'
		when (c.player_name is null) and 
		(p.current_season > p.last_active_season)
			then 'Stayed Retired'
		when c.season = p.last_active_season + interval '1 year'
			then 'Continued Playing'
		when c.season > p.last_active_season + interval '1 year'
			then 'Returned from Retirement'
	end as player_state,
	case 
		when c.player_name is not null
			then c.season
		else p.last_active_season
	end as last_active_season,
	'1998-01-01' as current_season
from prev as p
full join curr as c
	on p.player_name = c.player_name


select 
player_state, count(*) as c
from players_state
where current_season = '1998-01-01'
group by player_state
order by c desc
;	
